<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_weight="8">

    <GridView
        android:id="@+id/gridView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/linear"
        android:background="#000000"
        android:clipChildren="true"
        android:columnWidth="50dp"
        android:horizontalSpacing="4dp"
        android:numColumns="2"
        android:padding="0dp"
        android:stretchMode="columnWidth"
        android:verticalSpacing="4dp">

    </GridView>

    <TextView
        android:id="@+id/txtNoFav"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/linear"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:textSize="30sp"
        android:textStyle="bold" />

<LinearLayout
    android:id="@+id/newWallLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_above="@id/fab_scroll_down"
    android:layout_alignParentRight="true"
    android:layout_marginRight="10dp"
    android:layout_marginTop="20dp"
    android:gravity="center"
    android:orientation="vertical"
    android:weightSum="10"
    android:layout_alignParentEnd="true"
    android:layout_marginEnd="10dp">

    <TextView
        android:id="@+id/txtNewMsg"
        android:layout_width="50dp"
        android:gravity="center"
        android:layout_height="0dp"
       android:layout_weight="5"
        android:text="New"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:background="@drawable/bg_new" />
    <ImageView
        android:id="@+id/imgDropNew"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:src="@drawable/ic_drop_new"/>
</LinearLayout>



    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_scroll_down"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/linear"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="17dp"
        android:src="@drawable/ic_down"
        app:backgroundTint="#FFEA00"
        app:fabSize="mini"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_scroll_up"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/linear"
        android:layout_alignParentEnd="true"
        android:layout_alignParentRight="true"
        android:layout_marginEnd="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="17dp"
        android:src="@drawable/ic_up"
        app:backgroundTint="#FFEA00"
        app:fabSize="mini"/>

    <LinearLayout
        android:id="@+id/linear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/windowBackground"
            app:itemIconTint="@color/background_tint_nav"
            app:itemTextColor="@color/background_tint_nav"
            app:menu="@menu/bottom_menu">
        </com.google.android.material.bottomnavigation.BottomNavigationView>





    </LinearLayout>


    <!-- <ImageView
         android:id="@+id/img12"
         android:layout_width="wrap_content"
         android:layout_height="wrap_content"
         android:padding="1dp"
         />-->

</RelativeLayout>